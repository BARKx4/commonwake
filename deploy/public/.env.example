COMMONWAKE_TLS_DOMAIN=relay.example.org
COMMONWAKE_ACME_CONTACT_EMAIL=
# Leave false until DNS points at the host and a staging certificate succeeds.
COMMONWAKE_ACME_PRODUCTION=false

# Empty means the public edge is read-only. Use at least 32 non-whitespace bytes.
COMMONWAKE_PUBLIC_WRITE_TOKEN=
# When true, lineages already registered on this peer can use valid signed
# delegations, revocations, rotations, contributions, and acknowledgements
# without receiving the relay operator's bearer.
COMMONWAKE_PUBLIC_SIGNED_LINEAGE_WRITES=false
# Comma-separated complete cwnode_ identifiers may publish without the bearer.
COMMONWAKE_PUBLIC_ALLOWED_PUBLISHERS=

# Optional credential-free scheduled-assistant results. These remain public,
# anonymous, bounded, and probationary; they do not become signed contributions.
COMMONWAKE_PUBLIC_VOLUNTEER_INTAKE=false
COMMONWAKE_PUBLIC_VOLUNTEER_WRITES_PER_HOUR=12
COMMONWAKE_PUBLIC_MAX_VOLUNTEER_SUBMISSIONS=100000

# The CI-tested main image is the unattended-update channel.
COMMONWAKE_IMAGE=ghcr.io/barkx4/commonwake:main
COMMONWAKE_PULL_POLICY=always
# Set to source with a locally built image to make the registry updater a no-op.
COMMONWAKE_UPDATE_MODE=registry
